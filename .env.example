# 股票分析模型 - 环境变量配置
# 复制此文件为 .env 并修改配置值

# ===== 通用配置 =====
STOCK_ENV=development
STOCK_DEBUG=false
STOCK_LOG_LEVEL=INFO

# ===== 数据配置 =====
# 数据源: akshare (默认,基于东方财富) / baostock (稳定备选,不受反爬影响)
# 注意: akshare依赖东方财富push2/push2his端点，可能因反爬策略导致连接失败
# 当akshare失败时，系统会自动降级到baostock
STOCK_DATA_DEFAULT_SOURCE=akshare

# Tushare Token (使用tushare时需要)
# STOCK_DATA_TUSHARE_TOKEN=your_token_here

# HTTP代理配置 (VPN/代理软件用户可能需要)
# -------------------------------------------------------
# 问题说明: 使用Clash/V2Ray等VPN时，可能导致akshare获取东方财富数据失败
# 原因: VPN可能将eastmoney.com路由到不可达的代理节点
#
# 解决方案(按优先级):
# 1. 在Clash配置中为eastmoney.com添加DIRECT规则(推荐):
#    rules:
#      - DOMAIN-SUFFIX,eastmoney.com,DIRECT
#      - DOMAIN-SUFFIX,push2his.eastmoney.com,DIRECT
#
# 2. 使用代理地址(如果VPN代理可以正常转发国内流量):
#    STOCK_DATA_PROXY_URL=http://127.0.0.1:7897
#
# 3. 禁用代理直连(仅在VPN未使用TUN模式时有效):
#    STOCK_DATA_PROXY_URL=none
#
# 4. 临时关闭VPN运行此项目
# -------------------------------------------------------
# STOCK_DATA_PROXY_URL=http://127.0.0.1:7897
# STOCK_DATA_PROXY_URL=none

# 不走代理的地址(配合代理使用)
# STOCK_DATA_NO_PROXY=*.eastmoney.com,localhost,127.0.0.1

# ===== 缓存配置 =====
# 启用数据缓存 (减少重复网络请求, 提升性能)
# STOCK_DATA_CACHE_ENABLED=true

# 缓存有效期(秒) (默认1小时, 历史数据可设更大值如86400=24小时)
# STOCK_DATA_CACHE_TTL=3600