# 股票分析模型 - 环境变量配置
# 复制此文件为 .env 并修改配置值

# ===== 通用配置 =====
STOCK_ENV=development
STOCK_DEBUG=false
STOCK_LOG_LEVEL=INFO

# ===== 数据配置 =====
# 数据源: akshare (默认,基于东方财富) / baostock (稳定备选,不受反爬影响)
# 注意: akshare依赖东方财富push2/push2his端点，可能因反爬策略导致连接失败
# 当akshare失败时，系统会自动降级到baostock
STOCK_DATA_DEFAULT_SOURCE=akshare

# Tushare Token (使用tushare时需要)
# STOCK_DATA_TUSHARE_TOKEN=your_token_here

# HTTP代理配置 (VPN/代理软件用户可能需要)
# -------------------------------------------------------
# 问题说明: 使用Clash/V2Ray等VPN时，可能导致akshare获取东方财富数据失败
# 原因: VPN可能将eastmoney.com路由到不可达的代理节点
#
# 解决方案(按优先级):
# 1. 在Clash配置中为eastmoney.com添加DIRECT规则(推荐):
#    rules:
#      - DOMAIN-SUFFIX,eastmoney.com,DIRECT
#      - DOMAIN-SUFFIX,push2his.eastmoney.com,DIRECT
#
# 2. 使用代理地址(如果VPN代理可以正常转发国内流量):
#    STOCK_DATA_PROXY_URL=http://127.0.0.1:7897
#
# 3. 禁用代理直连(仅在VPN未使用TUN模式时有效):
#    STOCK_DATA_PROXY_URL=none
#
# 4. 临时关闭VPN运行此项目
# -------------------------------------------------------
# STOCK_DATA_PROXY_URL=http://127.0.0.1:7897
# STOCK_DATA_PROXY_URL=none

# 不走代理的地址(配合代理使用)
# STOCK_DATA_NO_PROXY=*.eastmoney.com,localhost,127.0.0.1

# ===== 缓存配置 =====
# 启用数据缓存 (减少重复网络请求, 提升性能)
# STOCK_DATA_CACHE_ENABLED=true

# 缓存有效期(秒) (默认1小时, 历史数据可设更大值如86400=24小时)
# STOCK_DATA_CACHE_TTL=3600

# ===== 失败告警 (模拟盘定时任务失败时主动通知) =====
# 为什么需要: 定时跑挂了如果只写日志, 你不会知道 —— 得天天去查接口。
# 配一个通道, 失败时它会主动找你。
#
# Webhook 地址(钉钉/飞书/企业微信机器人均可, 发的是 {"msgtype":"text"} 格式)
# ⚠️ URL 里带 access_token, 属凭据 —— 不要提交 .env, 接口也只回显主机名
# STOCK_NOTIFY_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your_token_here

# 是否同时打印到控制台 (默认 true)
# STOCK_NOTIFY_CONSOLE=true

# 可选: 告警也落盘一份(JSON 行), 便于事后回看
# STOCK_NOTIFY_FILE_PATH=data/paper/alerts.jsonl

# 连续失败时每 N 次再提醒一次(默认 3); 首次失败**总是**提醒。
# 设 0 表示只提醒首次, 适合不想被重复打扰的场景。
# STOCK_NOTIFY_ALERT_EVERY_N_FAILURES=3

# 总开关 (默认 true); 设为 false 则完全不推送告警
# STOCK_NOTIFY_ENABLED=true

# ===== 死信开关 (机器彻底关机/断网时的最后保障) =====
# 原理: 兜底脚本每次跑完 ping 一次这个 URL; 监控服务(如 healthchecks.io)
# 若在预期周期内没收到 ping, 就**由它主动**通知你 —— 通知能力在云端,
# 不依赖这台机器活着。这是前四层保障都覆盖不了的盲区。
# 配置步骤: 在 healthchecks.io 建 Check -> 把 ping URL 填到这里 ->
#           把 Check 的周期设为 1~2 天(兜底每天跑一次, 留宽余量防误报)
# STOCK_PING_URL=https://hc-ping.com/your-uuid